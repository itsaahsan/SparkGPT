{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sparkgpt-api.vercel.app/api/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "https://sparkgpt-api.vercel.app/favicon.ico"
    }
  ]
}
